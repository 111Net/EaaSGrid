"use client";


const API_URL =
process.env.NEXT_PUBLIC_API_URL ||
"/api";



export async function apiRequest(
    endpoint,
    options = {}
){

    const token =
        typeof window !== "undefined"
        ? localStorage.getItem("token")
        : null;



    const headers = {

        "Content-Type":
        "application/json",

        ...(options.headers || {})

    };



    if(token){

        headers.Authorization =
        `Bearer ${token}`;

    }



    const response =
        await fetch(
            `${API_URL}${endpoint}`,
            {

                ...options,

                headers

            }
        );



    return response;

}



export async function getApi(endpoint){

    return apiRequest(
        endpoint,
        {
            method:"GET"
        }
    );

}



export async function postApi(
    endpoint,
    body
){

    return apiRequest(

        endpoint,

        {

            method:"POST",

            body:
            JSON.stringify(body)

        }

    );

}
