"use client";

import { useEffect, useState } from "react";
import DashboardLayout from "@/components/layout/DashboardLayout";


function Metric({title,value}){

return (

<div
style={{
background:"#ffffff",
padding:"25px",
borderRadius:"18px",
boxShadow:"0 8px 20px rgba(0,0,0,0.08)"
}}
>

<h3
style={{
fontSize:"15px",
color:"#555",
marginBottom:"12px"
}}
>
{title}
</h3>


<div
style={{
fontSize:"30px",
fontWeight:"800",
color:"#123b63"
}}
>
{value}
</div>


</div>

);

}



export default function ControlCentre(){


const [dashboard,setDashboard]=useState(null);
const [error,setError]=useState("");



useEffect(()=>{


async function load(){


try{


const token =
localStorage.getItem(
"eaasgrid_token"
);



const response =
await fetch(

`${process.env.NEXT_PUBLIC_API_URL}/api/v1/dashboard`,

{
cache:"no-store",

headers:{
Authorization:
`Bearer ${token}`
}

}

);



if(!response.ok){

throw new Error(
"Dashboard unavailable"
);

}



const result =
await response.json();



setDashboard(
result.data
);



}

catch(err){

console.error(err);

setError(
"Unable to load XaaSGrid intelligence"
);


}



}


load();


},[]);




if(error){

return (

<DashboardLayout>

<div style={{padding:"40px",color:"red"}}>
{error}
</div>

</DashboardLayout>

);

}



if(!dashboard){

return (

<DashboardLayout>

<div style={{padding:"40px"}}>
Loading XaaSGrid intelligence...
</div>

</DashboardLayout>

);

}




return (

<DashboardLayout>


<div
style={{
padding:"30px"
}}
>


<div
style={{

background:
"linear-gradient(135deg,#071426,#123b63,#1d6fa5)",

padding:"40px",

borderRadius:"20px",

color:"white",

marginBottom:"30px"

}}
>


<h1
style={{
fontSize:"42px",
fontWeight:"800"
}}
>

⚡ XaaSGrid Command Centre

</h1>


<p>

Everything-as-a-Service Platform Intelligence

</p>


</div>





<div
style={{

display:"grid",

gridTemplateColumns:
"repeat(auto-fit,minmax(250px,1fr))",

gap:"20px"

}}
>



<Metric

title="Platform Status"

value={
dashboard.dashboard.status
}

/>



<Metric

title="Deployment Sites"

value={
dashboard.infrastructure.active_sites
}

/>



<Metric

title="Pilot Sites"

value={
dashboard.infrastructure.pilot_sites
}

/>



<Metric

title="Monthly Revenue"

value={
`₦${dashboard.finance.monthly_revenue}`
}

/>



<Metric

title="Energy Generated"

value={
dashboard.energy.monthly_generation
}

/>



<Metric

title="Availability"

value={
`${dashboard.performance.availability}%`
}

/>



</div>




<div
style={{

marginTop:"30px",

background:"#f5f7fa",

padding:"25px",

borderRadius:"15px"

}}
>


<h2>

Platform Synchronisation

</h2>


<p>

Last synchronisation:

<br/>

<strong>

{
new Date(
dashboard.dashboard.last_updated
)
.toLocaleString()

}

</strong>

</p>


</div>



</div>


</DashboardLayout>


);


}
