services:

  xaasgrid-api:

    build:
      context: ./apps/api

    container_name: xaasgrid-api

    ports:
      - "4000:4000"

    environment:

      NODE_ENV: production

      DATABASE_URL: ${DATABASE_URL}

      REDIS_URL: redis://xaasgrid-redis:6379

      JWT_SECRET: ${JWT_SECRET}

    depends_on:

      - xaasgrid-postgres
      - xaasgrid-redis

    restart: unless-stopped



  xaasgrid-dashboard:

    build:
      context: ./apps/dashboard

    container_name: xaasgrid-dashboard

    ports:

      - "3000:3000"


    environment:

      NODE_ENV: production


    depends_on:

      - xaasgrid-api


    restart: unless-stopped




  xaasgrid-postgres:

    image: postgres:15

    container_name: xaasgrid-postgres


    environment:

      POSTGRES_USER: ${POSTGRES_USER}

      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}

      POSTGRES_DB: ${POSTGRES_DB}


    ports:

      - "5432:5432"


    volumes:

      - infrastructure_postgres_data:/var/lib/postgresql/data


    restart: unless-stopped




  xaasgrid-redis:

    image: redis:7

    container_name: xaasgrid-redis


    ports:

      - "6379:6379"


    restart: unless-stopped




volumes:

  infrastructure_postgres_data:
